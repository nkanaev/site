{{ printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<rss version="2.0">
    <channel>
        <title>nkanaev</title>
        <link>{{ .Permalink }}</link>
        {{ range where .Site.RegularPages "Section" "posts" }}
        <item>
            <title>{{ .Title }}></title>
            <link>{{ .Permalink }}</link>
            <guid isPermaLink="false">{{ .RelPermalink }}</guid>
            <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
        </item>
        {{ end }}
    </channel>
</rss>
